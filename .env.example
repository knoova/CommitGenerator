GITHUB_WEBHOOK_SECRET=your_webhook_secret
# Comma-separated list of GitHub owners/orgs whose repos are accepted.
# Leave empty to accept all (dev only — not recommended in production).
ALLOWED_OWNERS=thinkpinkstudio,myorg
MY_FACE_URL=/my_face.png
COMPANY_LOGO_URL=/company_logo.png
SOCIAL_POST_BASE_URL=

# MiniMax Music API — genera canzone completa con voce cantata in italiano
# Registrati su: https://platform.minimax.io
MINIMAX_API_KEY=your_minimax_api_key

# Google AI (opzionale, usato solo se si vuole ripristinare Lyria 2 + Gemini TTS)
# GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# YouTube (richiede client_secret.json nella root del progetto)
YOUTUBE_ENABLED=true
YOUTUBE_PRIVACY=private

# Facebook
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
