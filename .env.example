GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_REPO=owner/repo-name
MY_FACE_URL=/my_face.png
COMPANY_LOGO_URL=/company_logo.png
SOCIAL_POST_BASE_URL=

# Google AI / Vertex AI (obbligatori per musica e voce)
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
# Autenticazione Vertex AI: impostare una delle seguenti:
#   - GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   - oppure eseguire: gcloud auth application-default login

# YouTube (richiede client_secret.json nella root del progetto)
YOUTUBE_ENABLED=false
YOUTUBE_PRIVACY=unlisted

# Facebook
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
